# 이 파일을 .env 로 복사한 뒤 값을 바꿔서 사용하세요.

# 관리자 화면(/admin) 로그인 비밀번호 (필수). 비어 있으면 관리자 로그인이 막힙니다.
ADMIN_PASSWORD=

# 로그인 쿠키 서명용 비밀키. 비워두면 서버를 켤 때마다 새로 만들어져
# 재시작하면 관리자가 다시 로그인해야 합니다. 아래 명령으로 만들 수 있습니다:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 화면 상단에 표시할 이름
STORE_NAME=순번 대기

# 이 일수가 지난 접수 기록은 이름·전화번호 뒷자리를 자동 삭제 (통계 숫자는 유지)
RETENTION_DAYS=30

# 현황판(/board) QR코드에 넣을 손님 접속 주소. 비우면 이 PC의 IP로 자동 설정.
# 고정 주소나 도메인이 있으면 지정하세요. 예: http://192.168.0.10:8000/
PUBLIC_URL=

# DB 위치. PostgreSQL 예: postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./queue.db
